# TypeSafe AI — get a key at https://console.typesafe.ai/keys
# Leave empty to run fully offline (built-in classifier, same output shape).
TYPESAFE_API_KEY=

# Pinned Jev model version (optional)
JEV_MODEL=jev-1.13.0

# Override endpoint (optional)
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Force the offline classifier even when a key is set
NEXT_PUBLIC_USE_MOCK=false

# Optional YouTube Data API v3 key (music card fallback resolver)
YOUTUBE_API_KEY=

# Optional free LLM tiers for the Schema Studio translator (later phases)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
GROQ_API_KEY=
GEMINI_API_KEY=
